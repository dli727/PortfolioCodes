import cv2 as cv
import time
import numpy as np
import mediapipe as mp
from mediapipe.tasks import python
from mediapipe.tasks.python import vision
import serial
import math
from pathlib import Path

BaseOptions = mp.tasks.BaseOptions
HandLandmarker = mp.tasks.vision.HandLandmarker
HandLandmarkerOptions = mp.tasks.vision.HandLandmarkerOptions
HandLandmarkerResult = mp.tasks.vision.HandLandmarkerResult
VisionRunningMode = mp.tasks.vision.RunningMode

#store results so the drawing can be applied
latest_result = None

# which nodes connect to who
HAND_CONNECTIONS = [
    (0,1),(1,2),(2,3),(3,4),
    (0,5),(5,6),(6,7),(7,8),
    (0,9),(9,10),(10,11),(11,12),
    (0,13),(13,14),(14,15),(15,16),
    (0,17),(17,18),(18,19),(19,20)
]

# Create a hand landmarker instance with the live stream mode:
def print_result(result: HandLandmarkerResult, output_image: mp.Image, timestamp_ms: int):
    #print('hand landmarker result: {}'.format(result))
    global latest_result
    latest_result = result



def draw_landmarks(frame, hand_landmarker_result: HandLandmarkerResult):
    if hand_landmarker_result is None:
        return frame, None, None
    
    h, w, _ = frame.shape

    thumb = (0,0)
    index = (0,0)
    for hand in hand_landmarker_result.hand_landmarks:
        # Convert normalized landmarks to pixel coords
        
        points = []

        for lm in hand:
            x = int(lm.x * w)
            y = int(lm.y * h)
            points.append((x,y))
            cv.circle(frame, (x,y), 4, (0,255,0), -1)

        # Draw connections
        for a,b in HAND_CONNECTIONS:
            cv.line(frame, points[a], points[b], (255,0,0), 2)

        cv.line(frame, points[4], points[8], (0,0,255), 2)
        thumb, index = points[4], points[8]

    return frame, thumb, index

def calc_rot(thumb, index):
    if thumb == None or index == None:
        return 0
    
    xdiff = thumb[0] - index[0]
    ydiff = thumb[1] - index[1]

    angle = math.atan2(ydiff,xdiff)
    return angle * (180/math.pi)
            
def moveServ(angle):
    if 0 <= angle <= 180:
        command = f"{angle}\n"
        ser.write(command.encode('utf-8'))
        print(f"Sent angle: {angle}")
    else:
        print("Angle must be between 0 and 180 degrees.")

ser = serial.Serial('COM5', 9600, timeout=1) 
time.sleep(2)
cap = cv.VideoCapture(0)
MODEL_PATH = Path(__file__).parent / "hand_landmarker.task"

# Create a hand landmarker instance with the video mode:
options = HandLandmarkerOptions(
    base_options=BaseOptions(model_asset_path=str(MODEL_PATH)),
    running_mode=VisionRunningMode.LIVE_STREAM,
    result_callback=print_result,
    num_hands = 1) # change this if i want to do 1 or two hands.
with HandLandmarker.create_from_options(options) as landmarker:

    while True:
        ret, frame = cap.read()
        
        if not ret:
            break
        
        mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=frame)
        timestamp_ms = int(time.time() * 1000)
        hand_landmarker_result = landmarker.detect_async(mp_image, timestamp_ms)
        #print_result(hand_landmarker_result, mp_image, int(cap.get(cv.CAP_PROP_POS_MSEC)))

        anno, thumb, index = draw_landmarks(frame, latest_result)
        angle = calc_rot(thumb,index)
        #print(angle)
        moveServ(angle)
        
        cv.imshow("feed", anno)

        k = cv.waitKey(1)
        if k == ord("q"):
            break

    cap.release()
    cv.destroyAllWindows()
    ser.close()

